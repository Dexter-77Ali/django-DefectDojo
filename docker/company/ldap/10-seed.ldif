# company: seed for the local OpenLDAP test directory (docker-compose.company.yml, profile ldap).
# Test accounts only. Passwords: alice123, bob123, carol123, dave123, sam123. dave never logs in in the manual
# checks: manage.py company_ldap_sync provisions him (product type and team) before his first login.

dn: ou=users,dc=company,dc=test
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=company,dc=test
objectClass: organizationalUnit
ou: groups

dn: uid=alice,ou=users,dc=company,dc=test
objectClass: inetOrgPerson
uid: alice
cn: Alice Admin
givenName: Alice
sn: Admin
mail: alice@company.test
userPassword: alice123

dn: uid=bob,ou=users,dc=company,dc=test
objectClass: inetOrgPerson
uid: bob
cn: Bob Builder
givenName: Bob
sn: Builder
mail: bob@company.test
userPassword: bob123

dn: uid=carol,ou=users,dc=company,dc=test
objectClass: inetOrgPerson
uid: carol
cn: Carol Contractor
givenName: Carol
sn: Contractor
mail: carol@company.test
userPassword: carol123

dn: uid=dave,ou=users,dc=company,dc=test
objectClass: inetOrgPerson
uid: dave
cn: Dave Developer
givenName: Dave
sn: Developer
mail: dave@company.test
userPassword: dave123

# sam: in the security team (dojo-security, whose members approve risk acceptance requests through
# DD_COMPANY_LDAP_RISK_APPROVER_GROUP) and a member of Research and Development, but no admin.
dn: uid=sam,ou=users,dc=company,dc=test
objectClass: inetOrgPerson
uid: sam
cn: Sam Security
givenName: Sam
sn: Security
mail: sam@company.test
userPassword: sam123

dn: cn=dojo-admins,ou=groups,dc=company,dc=test
objectClass: groupOfNames
cn: dojo-admins
member: uid=alice,ou=users,dc=company,dc=test

dn: cn=dojo-security,ou=groups,dc=company,dc=test
objectClass: groupOfNames
cn: dojo-security
member: uid=alice,ou=users,dc=company,dc=test
member: uid=sam,ou=users,dc=company,dc=test

dn: cn=dojo-pt-Research and Development,ou=groups,dc=company,dc=test
objectClass: groupOfNames
cn: dojo-pt-Research and Development
member: uid=bob,ou=users,dc=company,dc=test
member: uid=dave,ou=users,dc=company,dc=test
member: uid=sam,ou=users,dc=company,dc=test

dn: cn=dojo-team-wallet,ou=groups,dc=company,dc=test
objectClass: groupOfNames
cn: dojo-team-wallet
member: uid=bob,ou=users,dc=company,dc=test
member: uid=dave,ou=users,dc=company,dc=test
