# ZainCash company profile for the DefectDojo fork.
# Non-secret values only; pass with `docker compose --env-file companies/zaincash/zaincash.env ...`
# so every ${VAR:-default} in the company compose files takes these values. Secrets stay in ./secrets/.
# Palette, directory values and addresses are PLACEHOLDERS until ZainCash supplies its brand guide,
# Active Directory details and distribution lists.

DD_COMPANY_NAME=ZainCash
DD_FOOTER_VERSION=3.3.200-company.1
DD_OS_MESSAGE_ENABLED=False
# Local time for UI dates and the daily SLA job (07:30); ZainCash operates in Iraq
DD_TIME_ZONE=Asia/Baghdad

# Placeholder green ramp (ZainCash brand colours to be confirmed)
DD_COMPANY_PALETTE='{"50": "#e8f6ee", "100": "#c6e9d5", "200": "#8fd3ab", "300": "#5dbd86", "400": "#35a969", "500": "#1f9654", "600": "#187a45", "700": "#126038", "800": "#0d472a", "900": "#08301c"}'

# Product fields for a payments company: owner team, business unit, PCI DSS scope, data classification
DD_COMPANY_FIELDS='{"owner-team": {"label": "Owner team"}, "business-unit": {"label": "Business unit", "choices": ["wallet", "merchant-services", "agent-network", "core-banking", "corporate-it"]}, "pci-scope": {"label": "PCI DSS scope", "choices": ["in-scope", "out-of-scope"]}, "data-classification": {"label": "Data classification", "choices": ["public", "internal", "confidential", "restricted"]}}'

# SLA day multipliers keyed on the upstream product Business criticality (very high, high, medium, low, very low, none); placeholder policy
DD_COMPANY_SLA_FACTORS='{"very high": 0.5, "high": 0.75, "medium": 1.0, "low": 1.0, "very low": 1.0}'

# Escalation copies (placeholder addresses; replace with the SOC distribution list)
DD_COMPANY_ESCALATION_EMAILS=soc@zaincash.example
DD_COMPANY_ESCALATION_EVENTS=sla_breach,sla_breach_combined,risk_acceptance_expiration

# Active Directory (placeholders; enable once the bind account and DNs are known).
# Bind password: secrets/dd_company_ldap_bind_password. LDAPS certificate from the internal CA:
# put the CA certificate (PEM) into secrets/dd_company_ldap_ca_cert. Mail relay: secrets/dd_email_url.
DD_COMPANY_LDAP_ENABLED=False
DD_COMPANY_LDAP_PROFILE=ad
DD_COMPANY_LDAP_SERVER_URI=ldaps://dc01.zaincash.local:636
DD_COMPANY_LDAP_START_TLS=False
DD_COMPANY_LDAP_BIND_DN=CN=svc-defectdojo,OU=Service Accounts,DC=zaincash,DC=local
DD_COMPANY_LDAP_USER_BASE=OU=Users,DC=zaincash,DC=local
DD_COMPANY_LDAP_GROUP_BASE=OU=Groups,DC=zaincash,DC=local
DD_COMPANY_LDAP_ADMIN_GROUP=CN=dojo-admins,OU=Groups,DC=zaincash,DC=local
DD_COMPANY_LDAP_PRODUCT_TYPE_GROUP_PREFIX=dojo-pt-
